# ==============================================================================
# COMMUNITY EMERGENCY RESPONSE PLATFORM - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-community-emergency-response-platform-dev-key-change-in-production!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=community_emergency_db
DB_USER=emergency_admin
DB_PASSWORD=emergency_secure_password_2026
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# CORS & Frontend Origins (React Web Portal & Mobile Dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# Redis & Celery Background Task Processing
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Guardian Escalation Policy Defaults (in seconds)
DEFAULT_PRIMARY_GUARDIAN_TIMEOUT_SECONDS=120
DEFAULT_SECONDARY_GUARDIAN_TIMEOUT_SECONDS=180
DEFAULT_COMMUNITY_BROADCAST_DELAY_SECONDS=300

# Notification Providers Configuration (development: console / mock)
NOTIFICATION_PROVIDER_SMS=console
NOTIFICATION_PROVIDER_EMAIL=console
NOTIFICATION_PROVIDER_PUSH=console

# Security & Verification
CONTACT_VERIFICATION_DEV_MODE=True
CONTACT_VERIFICATION_EXPIRY_MINUTES=10
CONTACT_VERIFICATION_MAX_ATTEMPTS=3
